---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Kirk Keel — Energy AI & Well Control Engineering",
  description = "25+ Years in Drilling, Completions & Well Control. Deterministic Multiphase Physics, Model Context Protocol (MCP) Tools, and Rig Edge AI."
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230f172a'/><text x='50' y='65' fill='%2338bdf8' font-family='monospace' font-weight='bold' font-size='50' text-anchor='middle'>K</text></svg>">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={Astro.url.href}>
</head>
<body class="bg-[#0b0e14] text-slate-200 antialiased flex flex-col min-h-screen selection:bg-cyan-500/20 selection:text-cyan-300">

  <!-- Header Navigation -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0b0e14]/85 border-b border-slate-800/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center font-mono font-bold text-slate-950 text-sm shadow-md shadow-cyan-500/20 group-hover:scale-105 transition-transform">
          KK
        </span>
        <div class="flex flex-col">
          <span class="font-bold tracking-tight text-white group-hover:text-cyan-400 transition-colors leading-none text-sm sm:text-base">Kirk Keel</span>
          <span class="text-[10px] font-mono text-cyan-400/90 tracking-widest uppercase">Energy AI // ENG</span>
        </div>
      </a>

      <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
        <a 
          href="/apps" 
          class:list={[
            "px-3 py-1.5 rounded-md transition-colors",
            currentPath.startsWith('/apps') ? "text-cyan-400 bg-cyan-950/40 border border-cyan-800/50" : "text-slate-300 hover:text-white hover:bg-slate-800/50"
          ]}
        >
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span>
          Live Apps
        </a>
        <a 
          href="/architecture" 
          class:list={[
            "px-3 py-1.5 rounded-md transition-colors hidden sm:inline-block",
            currentPath.startsWith('/architecture') ? "text-cyan-400 bg-cyan-950/40 border border-cyan-800/50" : "text-slate-300 hover:text-white hover:bg-slate-800/50"
          ]}
        >
          Architecture
        </a>
        <a 
          href="/blog" 
          class:list={[
            "px-3 py-1.5 rounded-md transition-colors",
            currentPath.startsWith('/blog') ? "text-cyan-400 bg-cyan-950/40 border border-cyan-800/50" : "text-slate-300 hover:text-white hover:bg-slate-800/50"
          ]}
        >
          Articles
        </a>
        <a 
          href="/about" 
          class:list={[
            "px-3 py-1.5 rounded-md transition-colors hidden md:inline-block",
            currentPath.startsWith('/about') ? "text-cyan-400 bg-cyan-950/40 border border-cyan-800/50" : "text-slate-300 hover:text-white hover:bg-slate-800/50"
          ]}
        >
          About
        </a>

        <!-- GitHub Profile Link -->
        <a 
          href="https://github.com/Greybeard00007" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="ml-2 p-2 text-slate-400 hover:text-white transition-colors rounded-lg hover:bg-slate-800/60"
          title="GitHub Profile (@Greybeard00007)"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800/80 bg-[#07090d] py-10 text-xs text-slate-500">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col items-center md:items-start gap-1">
        <p class="font-medium text-slate-400">Kirk Keel — Energy AI & Well Control Engineering</p>
        <p>Houston, Texas · 25+ Years Drilling, Completions & Well Intervention</p>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://kill.kcklayton.com" target="_blank" class="hover:text-cyan-400 transition-colors">5KR Kill Sheet</a>
        <a href="https://wellcontrol.kcklayton.com" target="_blank" class="hover:text-cyan-400 transition-colors">WellControl Suite</a>
        <a href="https://wellsim.kcklayton.com" target="_blank" class="hover:text-cyan-400 transition-colors">WellSim Simulator</a>
        <a href="https://5kroil.com" target="_blank" class="hover:text-cyan-400 transition-colors">5KR Oil</a>
        <a href="https://kcklayton.com" target="_blank" class="hover:text-cyan-400 transition-colors">Author Site</a>
      </div>
      <p class="text-slate-600 font-mono">© {new Date().getFullYear()} Kirk Keel. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
