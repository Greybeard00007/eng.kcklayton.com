---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout 
  title={`${post.data.title} — Kirk Keel`}
  description={post.data.description}
>

  <article class="max-w-3xl mx-auto py-6">

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-slate-800">
      <div class="flex items-center gap-2 mb-4">
        <a href="/blog" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">
          ← Back to Articles
        </a>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 mt-4 leading-relaxed font-normal">
        {post.data.description}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 mt-6 pt-6 border-t border-slate-800/60 text-xs font-mono text-slate-400">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-cyan-950 border border-cyan-800 flex items-center justify-center font-bold text-cyan-400 text-[10px]">
            KK
          </span>
          <span class="text-slate-300 font-semibold">{post.data.author}</span>
        </div>
        <time>
          {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
      </div>

      <div class="flex flex-wrap gap-2 mt-4">
        {post.data.tags.map(tag => (
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-900 text-cyan-400 border border-slate-800">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Article Body with Markdown & Math -->
    <div class="prose prose-invert prose-cyan max-w-none prose-headings:font-bold prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-li:text-slate-300 prose-pre:border prose-pre:border-slate-800 prose-pre:bg-slate-950/80 prose-code:font-mono prose-code:text-cyan-300 prose-hr:border-slate-800 prose-table:border-collapse prose-th:border-b prose-th:border-slate-700 prose-th:text-white prose-td:border-b prose-td:border-slate-800/80 prose-td:text-slate-300 prose-strong:text-white">
      <Content />
    </div>

    <!-- Article Footer / Author Bio -->
    <div class="mt-16 pt-8 border-t border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center font-mono font-bold text-slate-950 text-lg shadow-md shadow-cyan-500/20">
          KK
        </div>
        <div>
          <h4 class="font-bold text-white text-sm">Kirk Keel</h4>
          <p class="text-xs text-slate-400">Energy AI Architect & Principal Well Operations Engineer (25+ Years)</p>
        </div>
      </div>

      <a href="/blog" class="text-xs font-mono text-cyan-400 hover:text-cyan-300">
        ← Back to all articles
      </a>
    </div>

  </article>

</BaseLayout>
